#!/usr/bin/env python3
"""手机 ⇄ Mac 的 Codex 会话同步（供 PocketAgent 的 /sync 使用）。

协议（和 Android 端 sync/SyncProtocol.kt 对齐）：

  dump [limit]      一行一组：id \t 标题 \t 开始时间 \t 更新时间(ms) \t 条数 \t 版本
  dumpids <id...>   只返回指定会话的清单行
  manifest [token]  增量清单；token 未变时只返回一行
  dumpfull         完整快照：清单字段后附 gz \t base64(gzip(正文))
  exportbatch <id...> 一次扫描后导出多组正文
  rollout [id...]   只把指定会话落成 Codex 原生记录
  trash            列出回收站中的会话组（JSON）
  restore <id>     恢复所选组，拒绝覆盖已有文件
  purge <id>       永久删除所选组的回收站文件，保留活跃会话
  purgebatch --stdin  从 stdin JSON 数组读取所选 id，一次扫描后批量永久删除
  list              兼容旧格式：路径 \t 开始时间 \t 条数 \t 首句
  export <id>       打印某一组的正文
  （无参数）        兼容旧行为：打印最近一组会话

会话来源两处：
1. ~/.codex/sessions/**/*.jsonl（终端 Codex 的历史）
2. ~/.pocketagent/sync/from-phone/*.json（手机推上来的，同 id 时覆盖第 1 种）
"""
import base64
import gzip
import glob
import hashlib
import json
import os
import re
import sys
import tempfile
import time
from collections import Counter

MAX_MESSAGES = int(os.environ.get("POCKETAGENT_SYNC_MESSAGES", "0"))
# 不截断：双向同步要求两边内容一致，截断推回去会把 Mac 上的历史覆盖成残本
MAX_CHARS = int(os.environ.get("POCKETAGENT_SYNC_CHARS", "50000000"))
# 0 表示全部；不能把「最近 N 组」冒充完整清单，否则旧会话会被误判为远端没有。
LIST_LIMIT = int(os.environ.get("POCKETAGENT_SYNC_LIST", "0"))
MAX_ROLLOUT_BYTES = int(os.environ.get("POCKETAGENT_MAX_ROLLOUT_BYTES", "0"))

FROM_PHONE_DIR = os.path.expanduser(
    os.environ.get("POCKETAGENT_FROM_PHONE_DIR", "~/.pocketagent/sync/from-phone")
)
# 手机会话落成 Codex 原生 rollout 的目录；测试时可以指到临时目录
CODEX_HOME = os.path.expanduser(os.environ.get("POCKETAGENT_CODEX_HOME", "~/.codex"))
CODEX_SESSIONS = os.path.join(CODEX_HOME, "sessions")
CODEX_CONFIG = os.path.join(CODEX_HOME, "config.toml")
SYNC_CACHE = os.path.expanduser(
    os.environ.get("POCKETAGENT_SYNC_CACHE", "~/.pocketagent/sync/context-index-v1.json")
)
SYNC_CACHE_VERSION = 4
UUID_RE = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
FRAMED_MAGIC = "<!-- pocketagent-framed-v2 -->"
LENGTH_PREFIX = "<!-- pocketagent-text-bytes:"

_SYNC_INDEX = None
_SYNC_INDEX_DIRTY = False


def text_of(content):
    if isinstance(content, str):
        return content
    parts = []
    for block in content or []:
        if isinstance(block, dict):
            if block.get("type") in ("input_text", "output_text", "text"):
                parts.append(block.get("text") or "")
        elif isinstance(block, str):
            parts.append(block)
    return "\n".join(p for p in parts if p)


APPROVAL_HISTORY_PREFIX = "The following is the Codex agent history"
APPROVAL_RECORD_KEYS = {
    "outcome", "rationale", "risk_level", "user_authorization",
}
PROGRESS_RECORD_KEYS = {
    "constraints", "critical_references", "current_progress", "next_steps",
}


def approval_record(text):
    """Match the desktop approval JSON that must never become mobile chat history."""
    trimmed = text.strip()
    if not trimmed.startswith("{"):
        return False
    if '"outcome"' not in trimmed and '"current_progress"' not in trimmed:
        return False
    try:
        row = json.loads(trimmed)
    except (ValueError, TypeError):
        row = None
    if isinstance(row, dict):
        if "current_progress" in row and set(row).issubset(PROGRESS_RECORD_KEYS):
            return True
        outcome = row.get("outcome")
        rationale = row.get("rationale")
        return (
            isinstance(outcome, str)
            and outcome.strip().lower() in {"allow", "allowed", "approved", "deny", "denied", "reject", "rejected"}
            and (rationale is None or isinstance(rationale, str))
            and set(row).issubset(APPROVAL_RECORD_KEYS)
        )
    outcome = re.search(r'"outcome"\s*:\s*"([^"]+)"', trimmed)
    if '"current_progress"' in trimmed:
        return True
    return bool(
        outcome
        and outcome.group(1).strip().lower()
        in {"allow", "allowed", "approved", "deny", "denied", "reject", "rejected"}
    )


def internal_sync_message(role, text):
    if text.lstrip().startswith((
        APPROVAL_HISTORY_PREFIX,
        "<codex_internal_context",
        "<environment_context>",
        "# AGENTS.md",
        "<INSTRUCTIONS>",
    )):
        return True
    return role == "assistant" and approval_record(text)


def all_rollouts():
    files = glob.glob(os.path.join(CODEX_SESSIONS, "**", "*.jsonl"), recursive=True)
    if not files:
        return []
    return sorted(files, key=os.path.getmtime, reverse=True)


def file_signature(path):
    stat = os.stat(path)
    return [stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns, stat.st_ino]


def sync_index():
    """Small metadata-only index: never cache conversation bodies."""
    global _SYNC_INDEX
    if _SYNC_INDEX is not None:
        return _SYNC_INDEX
    try:
        with open(SYNC_CACHE, encoding="utf-8") as fh:
            value = json.load(fh)
        if value.get("version") != SYNC_CACHE_VERSION:
            raise ValueError("cache version")
        value.setdefault("merged", {})
        for key in ("rollouts", "groups", "phone", "merged"):
            if not isinstance(value.get(key), dict):
                raise ValueError("cache shape")
    except (OSError, ValueError, TypeError, AttributeError):
        value = {
            "version": SYNC_CACHE_VERSION,
            "rollouts": {},
            "groups": {},
            "phone": {},
            "merged": {},
        }
    _SYNC_INDEX = value
    return value


def save_sync_index():
    global _SYNC_INDEX_DIRTY
    if not _SYNC_INDEX_DIRTY or _SYNC_INDEX is None:
        return
    directory = os.path.dirname(SYNC_CACHE) or "."
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=".context-index-", dir=directory)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(_SYNC_INDEX, fh, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(temporary, SYNC_CACHE)
            os.chmod(SYNC_CACHE, 0o600)
            _SYNC_INDEX_DIRTY = False
        except Exception:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            raise
    except OSError:
        # An unwritable cache only makes the next call slower; it must not break sync.
        pass


def message_digests(messages):
    values = []
    for role, text in messages:
        raw = text.encode("utf-8")
        value = hashlib.sha256()
        value.update(role.encode("ascii"))
        value.update(len(raw).to_bytes(8, "big"))
        value.update(raw)
        values.append(value.hexdigest())
    return values


def message_digest(messages):
    return digest_values(message_digests(messages))


def digest_values(values):
    digest = hashlib.sha256()
    for value in values:
        digest.update(value.encode("ascii"))
    return digest.hexdigest()


def sequence_revision(values):
    digest = hashlib.sha256()
    digest.update(b"pocketagent-message-sequence-v1\0")
    for value in values:
        digest.update(value.encode("ascii"))
        digest.update(b"\n")
    return digest.hexdigest()[:16]


def rollout_identity(path):
    """Read only the session_meta row unless an unchanged full entry is cached."""
    global _SYNC_INDEX_DIRTY
    cache = sync_index()
    try:
        signature = file_signature(path)
    except OSError:
        return None
    cached = cache["rollouts"].get(path)
    if isinstance(cached, dict) and cached.get("signature") == signature:
        return cached
    session_id = ""
    started = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                payload = row.get("payload") or {}
                if row.get("type") == "session_meta":
                    session_id = str(payload.get("session_id") or payload.get("id") or "")
                    started = str(payload.get("timestamp") or "")
                    break
    except OSError:
        return None
    entry = {
        "signature": signature,
        "session_id": session_id,
        "started": started,
        "complete": False,
    }
    cache["rollouts"][path] = entry
    _SYNC_INDEX_DIRTY = True
    return entry


def rollout_file_metadata(path):
    """Reuse parsed metadata while the rollout's size/mtime/inode are unchanged."""
    global _SYNC_INDEX_DIRTY
    cache = sync_index()
    try:
        signature = file_signature(path)
    except OSError:
        return None
    if MAX_ROLLOUT_BYTES > 0:
        try:
            if signature[0] > MAX_ROLLOUT_BYTES:
                raise ValueError("会话文件超过配置上限，拒绝返回不完整清单")
        except OSError:
            return None
    cached = cache["rollouts"].get(path)
    if (isinstance(cached, dict) and cached.get("signature") == signature
            and cached.get("complete") and isinstance(cached.get("messageDigests"), list)
            and isinstance(cached.get("firstUserTitle"), str)):
        return cached
    session_id = started = ""
    messages = []
    for _attempt in range(2):
        try:
            session_id, started, messages = read_messages(path)
            after_read = file_signature(path)
        except Exception:
            return None
        if after_read == signature:
            break
        # Codex 可能正在追加；切到刚刚完整读完的那一版，下一轮再校验。
        signature = after_read
    else:
        return None
    values = message_digests(messages)
    first_user = next((body for role, body in messages if role == "user"), "")
    entry = {
        "signature": signature,
        "session_id": session_id,
        "started": started,
        "messageCount": len(messages),
        "messageDigest": digest_values(values),
        "messageDigests": values,
        "firstUserTitle": first_user.replace("\n", " ").strip()[:60],
        "valid": bool(messages),
        "complete": True,
    }
    cache["rollouts"][path] = entry
    _SYNC_INDEX_DIRTY = True
    return entry


def normalize_wanted(wanted):
    if wanted is None:
        return None
    if isinstance(wanted, str):
        return {wanted}
    return set(wanted)


def wanted_paths(wanted):
    wanted = normalize_wanted(wanted)
    all_paths = all_rollouts()
    if wanted is None:
        return all_paths
    paths = []
    for path in all_paths:
        identity = rollout_identity(path) or {}
        if (identity.get("session_id") in wanted
                or any(value in os.path.basename(path) for value in wanted)):
            paths.append(path)
    return paths


def read_messages(path):
    messages = []
    session_id = ""
    started = ""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                row = json.loads(line)
            except Exception:
                continue
            payload = row.get("payload") or {}
            if row.get("type") == "session_meta":
                session_id = str(payload.get("session_id") or payload.get("id") or "")
                started = str(payload.get("timestamp") or "")
                continue
            if row.get("type") != "response_item" or payload.get("type") != "message":
                continue
            role = payload.get("role")
            if role not in ("user", "assistant"):
                continue
            body = text_of(payload.get("content")).strip()
            if not body:
                continue
            if body.startswith("<environment_context>") or body.startswith("# AGENTS.md"):
                continue
            if internal_sync_message(role, body):
                continue
            messages.append((role, body))
    return session_id, started, messages


def render(session_id, title, started, messages):
    out = ["# Codex 会话同步", FRAMED_MAGIC, f"- 会话：{session_id}", f"- 标题：{title}", f"- 开始：{started}", "- 来源：mac", ""]
    if MAX_MESSAGES > 0 and len(messages) > MAX_MESSAGES:
        raise ValueError("会话条数超过配置上限，拒绝截断导出")
    out.append(render_tail(messages))
    text = "\n".join(out)
    if len(text) <= MAX_CHARS:
        return text
    raise SystemExit(
        f"会话 {session_id} 有 {len(text)} 字符，超过 {MAX_CHARS} 上限；"
        "为避免双向同步丢内容，拒绝截断导出（可用 POCKETAGENT_SYNC_CHARS 调大）"
    )


def safe_name(raw):
    return "".join(c if (c.isalnum() or c in "-_") else "_" for c in str(raw))


def read_phone_file(path):
    with open(path, encoding="utf-8") as fh:
        row = json.load(fh)
    ctx_id = str(row.get("id") or "").strip()
    body = normalize_phone_body(str(row.get("body") or ""), int(row.get("count") or 0))
    if not ctx_id or not body:
        return None, None
    title = str(row.get("title") or "")[:60]
    started = str(row.get("startedAt") or "")
    records = message_records(body)
    clean_records = [
        record for record in records
        if not internal_sync_message(record[0], record[1])
    ]
    filtered = len(clean_records) != len(records)
    count_mismatch = int(row.get("count") or 0) not in (0, len(records))
    if filtered:
        header = body.split("\n## ", 1)[0].rstrip()
        body = header + "\n\n" + render_tail(clean_records) + "\n"
    if filtered or count_mismatch:
        revision = hashlib.sha1(body.encode("utf-8")).hexdigest()[:16]
    else:
        revision = str(row.get("rev") or hashlib.sha1(body.encode("utf-8")).hexdigest()[:16])
    return row, {
        "id": ctx_id,
        "title": title,
        "started": started,
        "updated": int(row.get("updatedAt") or int(os.path.getmtime(path) * 1000)),
        "count": len(clean_records),
        "rev": revision,
        "_messageDigests": message_digests(
            [(role, text) for role, text, _meta in clean_records]
        ),
        "body": body,
    }


def sync_phone_markdown(context):
    # Keep the readable copy current only when the source JSON changed or the copy vanished.
    md_path = os.path.join(FROM_PHONE_DIR, safe_name(context["id"]) + ".md")
    try:
        existing = None
        if os.path.exists(md_path):
            with open(md_path, encoding="utf-8", errors="replace") as fh:
                existing = fh.read()
        if existing != context["body"]:
            with open(md_path, "w", encoding="utf-8") as fh:
                fh.write(context["body"])
    except Exception:
        pass


def from_phone_contexts(wanted=None, include_body=False):
    global _SYNC_INDEX_DIRTY
    cache = sync_index()
    wanted = normalize_wanted(wanted)
    contexts = []
    for path in sorted(glob.glob(os.path.join(FROM_PHONE_DIR, "*.json"))):
        if wanted is not None and os.path.basename(path)[:-5] not in {safe_name(value) for value in wanted}:
            continue
        try:
            signature = file_signature(path)
        except OSError:
            continue
        cached = cache["phone"].get(path)
        if (isinstance(cached, dict) and cached.get("signature") == signature and cached.get("context")
                and isinstance(cached["context"].get("_messageDigests"), list)):
            context = dict(cached["context"])
            md_path = os.path.join(FROM_PHONE_DIR, safe_name(context["id"]) + ".md")
            needs_rollout = (
                os.environ.get("POCKETAGENT_CODEX_ROLLOUT", "1") != "0"
                and os.path.isdir(CODEX_HOME)
                and rollout_path_for(context["id"]) is None
            )
            if include_body or needs_rollout or not os.path.exists(md_path):
                try:
                    _row, loaded = read_phone_file(path)
                except Exception:
                    loaded = None
                if loaded:
                    context = {key: value for key, value in loaded.items() if key != "body"}
                    sync_phone_markdown(loaded)
                    ensure_codex_rollout(loaded)
                    cache["phone"][path] = {
                        "signature": file_signature(path),
                        "context": context,
                    }
                    _SYNC_INDEX_DIRTY = True
                    if include_body:
                        context = dict(context, body=loaded["body"])
            contexts.append(context)
            continue
        try:
            _row, loaded = read_phone_file(path)
        except Exception:
            continue
        if not loaded:
            continue
        context = {key: value for key, value in loaded.items() if key != "body"}
        sync_phone_markdown(loaded)
        # 顺手落一份 Codex 原生会话：电脑上 `codex resume <id>` 能直接接上
        ensure_codex_rollout(loaded)
        cache["phone"][path] = {
            "signature": signature,
            "context": context,
        }
        _SYNC_INDEX_DIRTY = True
        if include_body:
            context = dict(context, body=loaded["body"])
        contexts.append(context)
    save_sync_index()
    return contexts


def codex_contexts(limit, wanted=None, include_body=False):
    global _SYNC_INDEX_DIRTY
    cache = sync_index()
    # Codex 续聊会给同一个 session_id 再开一个 rollout 文件，
    # 这里按 session_id 合并，避免手机上出现两组重复上下文。
    paths = wanted_paths(wanted)
    by_session = {}
    for path in paths:
        entry = rollout_file_metadata(path)
        if not entry or not entry.get("valid"):
            continue
        key = entry.get("session_id") or path
        by_session.setdefault(key, []).append((entry.get("started") or "", path))

    contexts = []
    current_groups = set()
    for key, runs in by_session.items():
        current_groups.add(key)
        try:
            runs.sort(key=lambda row: (row[0], os.path.getmtime(row[1])))
        except OSError:
            continue
        token = [[path, os.stat(path).st_mtime_ns,
                  cache["rollouts"].get(path, {}).get("messageDigest", "")]
                 for _started, path in runs]
        cached = cache["groups"].get(key)
        if isinstance(cached, dict) and cached.get("token") == token:
            if cached.get("skip"):
                continue
            context = cached.get("context")
            if not context:
                continue
            if include_body:
                bodies = _codex_group_body(key, runs)
                if bodies is None:
                    continue
                context = dict(context, body=bodies)
            context = dict(context, _messageDigests=cached.get("messageDigests") or [])
            contexts.append(context)
            continue

        cached_context = cached.get("context") if isinstance(cached, dict) else None
        cached_digests = cached.get("messageDigests") if isinstance(cached, dict) else None
        run_digests = [cache["rollouts"].get(path, {}).get("messageDigests") for _started, path in runs]
        if any(value is None for value in run_digests):
            continue
        merged_digests = []
        for values in run_digests:
            append_history(merged_digests, values)
        if not merged_digests:
            continue
        title = next(
            (
                cache["rollouts"].get(path, {}).get("firstUserTitle", "")
                for _started, path in runs
                if cache["rollouts"].get(path, {}).get("firstUserTitle")
            ),
            "",
        )
        if title.startswith("The following is the Codex agent history"):
            cache["groups"][key] = {"token": token, "skip": True}
            _SYNC_INDEX_DIRTY = True
            continue
        try:
            updated = int(max(os.path.getmtime(path) for _started, path in runs) * 1000)
        except OSError:
            continue
        ctx_id = key if key != "" else ("codex-" + hashlib.sha1(runs[0][1].encode("utf-8")).hexdigest()[:12])
        context = {
            "id": ctx_id,
            "title": title,
            "started": runs[0][0],
            "updated": updated,
            "count": len(merged_digests),
            "rev": cached_context["rev"]
            if cached_context and cached_digests == merged_digests
            else sequence_revision(merged_digests),
            "_messageDigests": merged_digests,
        }
        cache["groups"][key] = {
            "token": token,
            "context": context,
            "messageDigests": merged_digests,
        }
        _SYNC_INDEX_DIRTY = True
        if include_body:
            bodies = _codex_group_body(key, runs)
            if bodies is None:
                continue
            context = dict(context, body=bodies)
        contexts.append(context)

    if wanted is None:
        cache["groups"] = {
            key: value for key, value in cache["groups"].items() if key in current_groups
        }
        surviving = set(paths)
        cache["rollouts"] = {
            path: value for path, value in cache["rollouts"].items() if path in surviving
        }
        _SYNC_INDEX_DIRTY = True
    save_sync_index()
    contexts.sort(key=lambda context: context["updated"], reverse=True)
    return contexts[:limit] if limit > 0 else contexts


def _codex_group_body(key, runs):
    merged_messages = []
    for _started, path in runs:
        try:
            _session_id, _file_started, messages = read_messages(path)
        except Exception:
            continue
        append_history(merged_messages, messages)
    if not merged_messages:
        return None
    cached = sync_index()["groups"].get(key, {}).get("context") or {}
    return render(
        cached.get("id") or key,
        cached.get("title") or "",
        cached.get("started") or runs[0][0],
        merged_messages,
    )


def append_history(existing, messages):
    """续聊重放可能远超 40 条；线性匹配完整重叠，不删除用户有意重复的消息。"""
    if not messages or (len(messages) <= len(existing) and existing[:len(messages)] == messages):
        return
    sequence = list(messages) + [None] + existing[-len(messages):]
    prefixes = [0] * len(sequence)
    for index in range(1, len(sequence)):
        matched = prefixes[index - 1]
        while matched and sequence[index] != sequence[matched]:
            matched = prefixes[matched - 1]
        if sequence[index] == sequence[matched]:
            matched += 1
        prefixes[index] = matched
    existing.extend(messages[prefixes[-1]:])


def unseen_occurrences(messages, have):
    """按出现次数比较，不能用 set 把新一轮相同的提问或回答吞掉。"""
    remaining = Counter(have)
    extra = []
    for message in messages:
        if remaining[message] > 0:
            remaining[message] -= 1
        else:
            extra.append(message)
    return extra


def merged_many(limit, wanted=None, include_body=False):
    """同一组会话可能两边都有：手机推上来的副本 + Mac 上继续聊产生的 rollout。

    以前这里让手机副本直接「遮住」Mac 的 rollout，结果是：手机上做的事推到 Mac 后，
    再用 codex resume 接着聊，新内容永远不会回到手机。现在合并两边：
    以手机副本的正文为底（保留工具调用/思考等元数据），把 Mac 独有的消息追加在后面。
    清单只返回元数据；正文只在确实需要传输某组时读取。
    """
    wanted = normalize_wanted(wanted)
    if include_body:
        phone = {context["id"]: context for context in from_phone_contexts(wanted, include_body=True)}
        out = {}
        for context in codex_contexts(0, wanted, include_body=True):
            local = phone.pop(context["id"], None)
            if local:
                merged_context = merge_pair(local, context)
                merged_context.update(merged_metadata(local, context))
                out[context["id"]] = merged_context
            else:
                out[context["id"]] = context
        out.update(phone)
    else:
        phone = {context["id"]: context for context in from_phone_contexts(wanted)}
        codex = {context["id"]: context for context in codex_contexts(0, wanted)}
        overlap = set(phone) & set(codex)
        merge_cache = sync_index()["merged"]
        out = {}
        for context in codex.values():
            local = phone.get(context["id"])
            if not local:
                out[context["id"]] = context
                continue
            key = merged_cache_key(local, context)
            cached = merge_cache.get(context["id"])
            if cached and cached.get("key") == key and cached.get("context"):
                out[context["id"]] = dict(cached["context"])
                continue
            metadata = merged_metadata(local, context)
            merge_cache[context["id"]] = {"key": key, "context": metadata}
            _mark_index_dirty()
            out[context["id"]] = metadata
        for context in phone.values():
            if context["id"] not in out:
                out[context["id"]] = context
    save_sync_index()
    ordered = sorted(out.values(), key=lambda context: context["updated"], reverse=True)
    return ordered[:limit] if limit > 0 else ordered


def merged(limit, wanted=None, include_body=False):
    return merged_many(limit, wanted, include_body=include_body)


def metadata_line(context):
    title = context["title"].replace("\t", " ").replace("\n", " ")
    return "\t".join(
        [
            context["id"],
            title,
            context["started"].replace("\t", " "),
            str(context["updated"]),
            str(context["count"]),
            context["rev"],
        ]
    )


def merged_cache_key(local, remote):
    return [
        local.get("rev"), local.get("updated"), local.get("count"), local.get("title"),
        remote.get("rev"), remote.get("updated"), remote.get("count"), remote.get("title"),
        sequence_revision(local.get("_messageDigests") or []),
        sequence_revision(remote.get("_messageDigests") or []),
    ]


def merged_metadata(local, remote):
    """Compute merge_pair's public result without materializing either body."""
    local_digests = local.get("_messageDigests") or []
    remote_digests = remote.get("_messageDigests") or []
    if not local_digests:
        return public_local_metadata(local, local_digests)
    extra = unseen_occurrences(remote_digests, local_digests)
    if not extra:
        return public_local_metadata(local, local_digests)
    newer = int(remote.get("updated") or 0) > int(local.get("updated") or 0)
    prefix = len(local_digests) <= len(remote_digests) and remote_digests[:len(local_digests)] == local_digests
    if not (newer or prefix):
        return public_local_metadata(local, local_digests)
    digest = hashlib.sha256()
    digest.update(b"pocketagent-merged-v1\0")
    digest.update(str(local.get("rev") or "").encode("utf-8"))
    digest.update(b"\0")
    digest.update(str(remote.get("rev") or "").encode("utf-8"))
    for value in local_digests:
        digest.update(value.encode("ascii"))
    digest.update(b"\0")
    for value in extra:
        digest.update(value.encode("ascii"))
    return {
        "id": local.get("id") or remote.get("id") or "",
        "title": local.get("title") or remote.get("title") or "",
        "started": local.get("started") or remote.get("started") or "",
        "updated": max(int(local.get("updated") or 0), int(remote.get("updated") or 0)),
        "count": len(local_digests) + len(extra),
        "rev": digest.hexdigest()[:16],
    }


def public_local_metadata(local, digests):
    result = {
        name: local.get(name, default)
        for name, default in (
            ("id", ""), ("title", ""), ("started", ""), ("updated", 0), ("count", 0), ("rev", "")
        )
    }
    if digests and result["count"] != len(digests):
        result["count"] = len(digests)
        result["rev"] = sequence_revision(digests)
    return result


def _mark_index_dirty():
    global _SYNC_INDEX_DIRTY
    _SYNC_INDEX_DIRTY = True


def manifest_token(contexts):
    digest = hashlib.sha256()
    for context in sorted(contexts, key=lambda row: row["id"]):
        digest.update(json.dumps(
            [context["id"], context.get("title", ""), context.get("count", 0), context.get("rev", "")],
            ensure_ascii=False,
            separators=(",", ":"),
        ).encode("utf-8"))
        digest.update(b"\n")
    return digest.hexdigest()[:32]


def codex_model_provider():
    """Codex 会检查会话里的 model_provider 是否还配置着；跟着本机 config.toml 走。"""
    try:
        with open(CODEX_CONFIG, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                stripped = line.strip()
                if stripped.startswith("model_provider"):
                    return stripped.split("=", 1)[1].strip().strip('"').strip("'")
    except Exception:
        pass
    return "openai"


def rollout_message_rows(path):
    rows = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                payload = row.get("payload") or {}
                if row.get("type") != "response_item" or payload.get("type") != "message":
                    continue
                role = payload.get("role")
                if role not in ("user", "assistant"):
                    continue
                text = text_of(payload.get("content")).strip()
                if text:
                    rows.append((role, text))
    except Exception:
        pass
    return rows


def rollout_row(role, text):
    return {
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime()),
        "type": "response_item",
        "payload": {
            "type": "message",
            "role": role,
            "content": [
                {"type": "input_text" if role == "user" else "output_text", "text": text}
            ],
        },
    }


def ensure_codex_rollout(ctx):
    """把手机端的会话落成 Codex 原生 rollout，电脑上就能 `codex resume <会话id>` 接着聊。

    只写一次；之后手机上新增的消息追加到末尾，Mac 上自己聊出来的内容原样保留。
    格式是最小集合（session_meta + response_item），实测这个版本的 codex resume 能认。
    """
    if os.environ.get("POCKETAGENT_CODEX_ROLLOUT", "1") == "0":
        return
    # 目标机上没装 Codex（没有 ~/.codex）就别造目录了，md/json 副本照样能用
    if not os.path.isdir(CODEX_HOME):
        return
    try:
        ctx_id = str(ctx.get("id") or "")
        if not re.fullmatch(UUID_RE, ctx_id):
            return
        records = message_records(ctx.get("body") or "")
        if ctx.get("count", 0) > 0 and len(records) != ctx["count"]:
            # 老版本无角色标记的正文可能已歧义，不能把错误解析追加到原生历史。
            return
        messages = [
            (role, text.strip())
            for role, text, _meta in records
            # 斜杠命令回显不是对话内容，别带进 Codex 的历史里
            if text.strip() and not (role == "user" and text.lstrip().startswith("/"))
        ]
        existing = rollout_path_for(ctx_id)
        if existing:
            # 空会话也有价值：手机在全新对话里第一次用 /workspace 时，先建 session_meta，
            # 下一句就能 resume 同一个 id，避免电脑上多出一条重复会话。
            if not messages:
                return
            path = existing
            todo = unseen_occurrences(messages, rollout_message_rows(path))
            if not todo:
                return
            with open(path, "a", encoding="utf-8") as fh:
                for role, text in todo:
                    fh.write(json.dumps(rollout_row(role, text), ensure_ascii=False) + "\n")
            return
        stamp = time.localtime()
        day = os.path.join(CODEX_SESSIONS, time.strftime("%Y/%m/%d", stamp))
        os.makedirs(day, exist_ok=True)
        path = os.path.join(
            day,
            "rollout-" + time.strftime("%Y-%m-%dT%H-%M-%S", stamp) + "-" + ctx_id + ".jsonl",
        )
        started = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())
        meta = {
            "timestamp": started,
            "type": "session_meta",
            "payload": {
                "id": ctx_id,
                "session_id": ctx_id,
                "timestamp": started,
                "cwd": os.path.expanduser("~"),
                "originator": "pocketagent",
                "cli_version": "0.1.0",
                "model_provider": codex_model_provider(),
            },
        }
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(meta, ensure_ascii=False) + "\n")
            for role, text in messages:
                fh.write(json.dumps(rollout_row(role, text), ensure_ascii=False) + "\n")
        _ROLLOUT_INDEX[ctx_id] = path
    except Exception:
        # 写不出原生会话不影响同步本身：md/json 副本照样能用
        pass


_ROLLOUT_INDEX = {}
_ROLLOUT_INDEX_READY = False


def rollout_path_for(ctx_id):
    """一次同步只扫一遍 ~/.codex/sessions：会话多的时候逐个 glob 会很慢。"""
    global _ROLLOUT_INDEX_READY
    if not _ROLLOUT_INDEX_READY:
        _ROLLOUT_INDEX_READY = True
        for path in glob.glob(os.path.join(CODEX_SESSIONS, "**", "rollout-*.jsonl"), recursive=True):
            found = re.search(UUID_RE, os.path.basename(path))
            if found:
                _ROLLOUT_INDEX.setdefault(found.group(0), path)
    return _ROLLOUT_INDEX.get(ctx_id)


def framed_records(body):
    data = body.encode("utf-8")
    offset = 0
    out = []
    started = False

    def line():
        nonlocal offset
        if offset >= len(data):
            raise ValueError("缺少同步帧")
        end = data.find(b"\n", offset)
        if end < 0:
            end = len(data)
        value = data[offset:end].decode("utf-8")
        offset = min(end + 1, len(data))
        return value

    while offset < len(data):
        header = line()
        role = next((r for r in ("user", "assistant") if header == f"## {r} <!-- pocketagent-role:{r} -->"), None)
        if role is None:
            if started and header.strip():
                raise ValueError("同步帧之间包含无效内容")
            continue
        started = True
        meta = ""
        length = line()
        if length.startswith("<!-- pocketagent-message-v1:"):
            meta = length
            length = line()
        if not length.startswith(LENGTH_PREFIX) or not length.endswith(" -->"):
            raise ValueError("缺少消息长度")
        count = int(length[len(LENGTH_PREFIX):-4])
        if count < 0 or offset + count > len(data):
            raise ValueError("同步正文不完整")
        text = data[offset:offset + count].decode("utf-8")
        offset += count
        if line() != "" or line() != "<!-- pocketagent-message-end -->":
            raise ValueError("同步帧结束标记缺失")
        out.append((role, text, meta))
    return out


def message_records(body):
    """与手机 SyncProtocol 一致：有标记时只认标记，代码围栏中的标题是正文。"""
    if body.startswith("# Codex 会话同步\n" + FRAMED_MAGIC + "\n"):
        return framed_records(body)
    out = []
    role = None
    buf = []
    fence = None
    tagged = "<!-- pocketagent-role:" in body
    meta = ""

    def flush():
        if role is not None:
            text = "\n".join(buf).strip()
            if text or meta:
                out.append((role, text, meta))

    for line in body.splitlines():
        clean = line.rstrip()
        if fence is not None:
            buf.append(line)
            if line.lstrip().startswith(fence):
                fence = None
            continue
        head = None
        for candidate in ("user", "assistant"):
            expected = f"## {candidate} <!-- pocketagent-role:{candidate} -->" if tagged else f"## {candidate}"
            if clean == expected:
                head = candidate
        if head:
            flush()
            role = head
            buf = []
            meta = ""
        elif tagged and clean == "<!-- pocketagent-message-end -->":
            flush()
            role = None
            buf = []
            meta = ""
        elif role is not None:
            # 只忽略元数据行；用户正文里其它 HTML 注释必须保留。
            if not buf and clean.startswith("<!-- pocketagent-message-v1:") and clean.endswith(" -->"):
                meta = line
                continue
            if line.lstrip().startswith("```"):
                fence = "```"
            elif line.lstrip().startswith("~~~"):
                fence = "~~~"
            buf.append(line)
    flush()
    return out


def message_list(body):
    return [(role, text.strip()) for role, text, _ in message_records(body)]


def normalize_phone_body(body, count):
    """可确认边界的旧手机正文迁移到 v2；含歧义的旧正文原样保留，留待重新导出。"""
    if not body or body.startswith("# Codex 会话同步\n" + FRAMED_MAGIC + "\n"):
        return body
    records = message_records(body)
    if count > 0:
        # 旧版未闭合围栏会吞后面的角色。只有显式角色和 END 数量都完全相符时才恢复。
        headers = list(re.finditer(r"^## (user|assistant) <!-- pocketagent-role:\1 -->\n", body, re.M))
        ends = list(re.finditer(r"^<!-- pocketagent-message-end -->$", body, re.M))
        if len(headers) == count and len(ends) == count:
            records = []
            for index, (header, end) in enumerate(zip(headers, ends)):
                if end.start() < header.end() or (index + 1 < count and end.end() > headers[index + 1].start()):
                    return body
                text = body[header.end():end.start()]
                if text.endswith("\n"):
                    text = text[:-1]
                meta = ""
                if text.startswith("<!-- pocketagent-message-v1:"):
                    meta, _, text = text.partition("\n")
                records.append((header.group(1), text, meta))
        elif len(records) != count:
            return body
    # 保留原来的会话头、工具调用元数据及正文，不改文件里的源数据或内容版本号。
    head = body.split("\n## ", 1)[0]
    first, _, rest = head.partition("\n")
    return first + "\n" + FRAMED_MAGIC + "\n" + rest.rstrip() + "\n\n" + render_tail(records) + "\n"


def render_tail(messages):
    blocks = []
    for message in messages:
        role, text = message[:2]
        meta = message[2] if len(message) > 2 else ""
        blocks.append(f"## {role} <!-- pocketagent-role:{role} -->\n" +
                      (meta + "\n" if meta else "") +
                      f"{LENGTH_PREFIX}{len(text.encode('utf-8'))} -->\n" + text +
                      "\n<!-- pocketagent-message-end -->")
    return "\n\n".join(blocks)


def merge_pair(local, remote):
    """local = 手机推上来的副本，remote = Mac 上同 id 的 rollout。"""
    if not local:
        return remote
    local_msgs = message_list(local["body"])
    if local.get("count", 0) > 0 and len(local_msgs) != local["count"]:
        # 一组遗留会话异常不能让其它所有组同步失败；也不能擅自猜边界再覆盖正文。
        return local
    remote_msgs = message_list(remote["body"])
    extra = unseen_occurrences(remote_msgs, local_msgs)
    if not extra:
        # Mac 那边没有新内容：保持手机副本原样，rev 不变，手机端不会误判为有更新
        return local
    # 只在「Mac 这一份确实更新」时把多出来的消息并回去：
    # - 时间戳更新（Mac 上刚继续聊过）
    # - 手机这份是 Mac 那份的前缀（明确的同一条线往下长）
    # 否则（例如手机刚 /compact 过，历史被有意压缩）以手机为准，避免把压缩掉的历史又灌回来。
    newer = int(remote.get("updated") or 0) > int(local.get("updated") or 0)
    prefix = len(local_msgs) <= len(remote_msgs) and remote_msgs[: len(local_msgs)] == local_msgs
    if not (newer or prefix):
        return local
    # 旧版本手机副本没有角色标记，追加前先整体迁移，避免混用两种格式。
    original = local["body"]
    if not original.startswith("# Codex 会话同步\n" + FRAMED_MAGIC + "\n"):
        records = message_records(original)
        if local.get("count", 0) > 0 and len(records) != local["count"]:
            raise ValueError("旧版手机会话解析不完整，拒绝合并覆盖")
        original = render(local["id"], local.get("title", ""), local.get("started", ""), records)
    body = original.rstrip() + "\n\n" + render_tail(extra) + "\n"
    merged_ctx = dict(local)
    merged_ctx["body"] = body
    merged_ctx["count"] = len(message_list(body))
    merged_ctx["rev"] = hashlib.sha1(body.encode("utf-8")).hexdigest()[:16]
    merged_ctx["updated"] = max(int(local.get("updated") or 0), int(remote.get("updated") or 0))
    if not merged_ctx.get("title"):
        merged_ctx["title"] = remote.get("title") or ""
    return merged_ctx


