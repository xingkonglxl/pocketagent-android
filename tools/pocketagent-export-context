TRASH_DIR = os.path.expanduser(os.environ.get("POCKETAGENT_TRASH_DIR", "~/.pocketagent/trash"))
TRASH_PROTOCOL = "pocketagent-trash-v1"


def valid_context_id(ctx_id):
    return isinstance(ctx_id, str) and re.fullmatch(r"[\w-]{1,200}", ctx_id) is not None


def file_identity(path, with_title=True):
    """Only read enough to identify a backup; never return its full conversation."""
    if path.endswith(".jsonl"):
        ctx_id, title = "", ""
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except (ValueError, TypeError):
                    continue
                payload = row.get("payload") or {}
                if row.get("type") == "session_meta":
                    ctx_id = str(payload.get("session_id") or payload.get("id") or "")
                    if not with_title:
                        return ctx_id, ""
                if row.get("type") == "response_item" and payload.get("role") == "user":
                    text = text_of(payload.get("content")).strip()
                    if text and not text.startswith(("# AGENTS.md", "<environment_context>")):
                        title = text[:60].replace("\n", " ")
                        break
        return ctx_id, title
    if path.endswith(".json"):
        with open(path, encoding="utf-8") as fh:
            row = json.load(fh)
        return str(row.get("id") or ""), str(row.get("title") or "")[:60]
    if path.endswith(".md"):
        return os.path.basename(path)[:-3], ""
    return "", ""


def trash_file(path, directory):
    """Manifests are data, not authority to delete an arbitrary path or symlink."""
    return (os.path.dirname(os.path.abspath(path)) == os.path.abspath(directory)
            and os.path.basename(path) != "moved.json"
            and not os.path.islink(path) and os.path.isfile(path))


def restore_destination(path):
    path = os.path.abspath(path)
    real = os.path.realpath(path)
    sessions = os.path.realpath(CODEX_SESSIONS) + os.sep
    phone = os.path.realpath(FROM_PHONE_DIR)
    return ((real.startswith(sessions) and path.endswith(".jsonl")) or
            (os.path.dirname(real) == phone and path.endswith((".json", ".md"))))


def trash_groups(wanted=None, with_titles=True):
    """Include legacy orphan files left by same-second manifest collisions."""
    if os.path.islink(TRASH_DIR):
        raise ValueError("回收站目录不能是符号链接")
    groups = {}
    for directory in sorted(glob.glob(os.path.join(TRASH_DIR, "*"))):
        if os.path.islink(directory) or not os.path.isdir(directory):
            continue
        manifest = os.path.join(directory, "moved.json")
        data = {}
        if not os.path.islink(manifest):
            try:
                with open(manifest, encoding="utf-8") as fh:
                    data = json.load(fh)
                if not isinstance(data, dict):
                    data = {}
            except (OSError, ValueError):
                pass
        candidates = []
        seen = set()
        for record in data.get("files") or []:
            if not isinstance(record, dict):
                continue
            src, dst = record.get("to"), record.get("from")
            if not isinstance(src, str) or not isinstance(dst, str):
                continue
            if trash_file(src, directory) and restore_destination(dst) and valid_context_id(data.get("id")):
                if os.path.abspath(src) in seen:
                    continue
                if wanted is None or data["id"] in wanted:
                    candidates.append((data["id"], str(data.get("title") or "")[:60], src, dst))
                seen.add(os.path.abspath(src))
        for src in sorted(glob.glob(os.path.join(directory, "*"))):
            if os.path.abspath(src) in seen or not trash_file(src, directory):
                continue
            try:
                ctx_id, title = file_identity(src, with_title=with_titles)
            except (OSError, ValueError, AttributeError, TypeError):
                continue
            if not valid_context_id(ctx_id) or (wanted is not None and ctx_id not in wanted):
                continue
            if src.endswith(".jsonl"):
                dst = os.path.join(CODEX_SESSIONS, "recovered", os.path.basename(src))
            elif src.endswith((".json", ".md")):
                dst = os.path.join(FROM_PHONE_DIR, safe_name(ctx_id) + os.path.splitext(src)[1])
            else:
                continue
            candidates.append((ctx_id, title, src, dst))
        deleted_at = data.get("deletedAt")
        if not isinstance(deleted_at, (int, float)):
            deleted_at = int(os.path.getmtime(directory) * 1000)
        for ctx_id, title, src, dst in candidates:
            group = groups.setdefault(ctx_id, {"id": ctx_id, "title": "", "deletedAt": 0, "files": []})
            if not title and with_titles:
                try:
                    _, title = file_identity(src)
                except (OSError, ValueError, AttributeError, TypeError):
                    pass
            if title:
                group["title"] = title
            group["deletedAt"] = max(group["deletedAt"], deleted_at)
            group["files"].append({"from": dst, "to": src})
    return groups


def cmd_trash():
    entries = []
    for group in trash_groups().values():
        entries.append({key: group[key] for key in ("id", "title", "deletedAt")})
        entries[-1]["bytes"] = sum(os.path.getsize(f["to"]) for f in group["files"])
    entries.sort(key=lambda item: (-item["deletedAt"], item["id"]))
    print(json.dumps({"protocol": TRASH_PROTOCOL, "entries": entries}, ensure_ascii=False))


def clean_trash_manifests(directories, ctx_id):
    for directory in directories:
        manifest = os.path.join(directory, "moved.json")
        if not os.path.islink(manifest):
            try:
                with open(manifest, encoding="utf-8") as fh:
                    data = json.load(fh)
                if data.get("id") == ctx_id and not any(
                        trash_file(f.get("to", ""), directory) for f in data.get("files") or [] if isinstance(f, dict)):
                    os.remove(manifest)
            except (OSError, ValueError, AttributeError):
                pass
        try:
            os.rmdir(directory)  # Only remove an empty directory, never another group's files.
        except OSError:
            pass


def purge_records(ctx_id, records):
    """Only unlink the already selected trash files, never rescan per group."""
    directories = set()
    for item in records:
        src = item["to"]
        directory = os.path.dirname(src)
        if not trash_file(src, directory):
            raise ValueError("回收站文件已变化，请刷新后重试")
        os.remove(src)
        directories.add(directory)
    clean_trash_manifests(directories, ctx_id)
    return len(records)


def cmd_purge(ctx_id):
    """Permanently remove only this group's trash backups; never active rollouts."""
    if not valid_context_id(ctx_id):
        raise ValueError("无效的会话 id")
    records = trash_groups({ctx_id}, with_titles=False).get(ctx_id, {}).get("files", [])
    purge_records(ctx_id, records)
    print(json.dumps({"protocol": TRASH_PROTOCOL, "deletedFiles": len(records)}))


def cmd_purge_batch(ids):
    # Validate the entire request before deleting anything. No invalid id may widen selection.
    if not isinstance(ids, list) or len(ids) > 10000 or not all(valid_context_id(i) for i in ids):
        raise ValueError("无效的批量会话 id")
    ids = list(dict.fromkeys(ids))
    groups = trash_groups(set(ids), with_titles=False) if ids else {}
    results = []
    for ctx_id in ids:
        try:
            count = purge_records(ctx_id, groups.get(ctx_id, {}).get("files", []))
            results.append({"id": ctx_id, "deletedFiles": count})
        except (OSError, ValueError) as exc:
            # Do not send private file paths back in error messages.
            detail = exc.strerror if isinstance(exc, OSError) else str(exc)
            results.append({"id": ctx_id, "deletedFiles": 0,
                            "error": type(exc).__name__ + ": " + (detail or "删除失败")})
    print(json.dumps({"protocol": "pocketagent-trash-batch-v1", "results": results}))


def cmd_delete(ctx_id, permanent=False):
    """将指定组的 rollout 和手机副本移到回收站；显式 permanent 时直接删除。"""
    if not valid_context_id(ctx_id):
        raise ValueError("无效的会话 id")
    moved = []
    paths = []
    title = ""
    for path in all_rollouts():
        try:
            sid, _ = file_identity(path, with_title=False)
        except (OSError, ValueError, AttributeError, TypeError):
            continue
        if sid == ctx_id:
            paths.append(path)
            _, candidate_title = file_identity(path)
            title = candidate_title or title
    for ext in (".json", ".md"):
        path = os.path.join(FROM_PHONE_DIR, safe_name(ctx_id) + ext)
        if os.path.isfile(path) and not os.path.islink(path):
            paths.append(path)
            if ext == ".json":
                try:
                    _, candidate_title = file_identity(path)
                    title = candidate_title or title
                except (OSError, ValueError, AttributeError, TypeError):
                    pass
    if permanent:
        for path in paths:
            os.remove(path)
            moved.append(path)
        print("\n".join(moved) if moved else "（这台机器上没有这组会话的副本）")
        return
    if not paths:
        print("（Mac 上没有这组会话的副本）")
        return
    os.makedirs(TRASH_DIR, mode=0o700, exist_ok=True)
    if os.path.islink(TRASH_DIR):
        raise ValueError("回收站目录不能是符号链接")
    trash = tempfile.mkdtemp(prefix=time.strftime("%Y%m%d-%H%M%S") + "-", dir=TRASH_DIR)
    records = []
    for index, path in enumerate(paths):
        target = os.path.join(trash, str(index) + "-" + os.path.basename(path))
        records.append({"from": path, "to": target})
    # Record every destination before moving anything, so interrupted deletes remain recoverable.
    with open(os.path.join(trash, "moved.json"), "x", encoding="utf-8") as fh:
        os.chmod(fh.name, 0o600)
        json.dump({"id": ctx_id, "title": title, "deletedAt": int(time.time() * 1000), "files": records},
                  fh, ensure_ascii=False)
        fh.flush()
        os.fsync(fh.fileno())
    for record in records:
        os.replace(record["from"], record["to"])
        moved.append(record["to"])
    print("\n".join(moved) if moved else "（Mac 上没有这组会话的副本）")


def cmd_restore(ctx_id):
    """从回收站把某一组会话搬回原位置；回收站被清过就返回空。"""
    if not valid_context_id(ctx_id):
        raise ValueError("无效的会话 id")
    records = trash_groups().get(ctx_id, {}).get("files", [])
    destinations = [item["from"] for item in records]
    if len(set(destinations)) != len(destinations):
        raise ValueError("存在多个指向同一位置的备份，未覆盖任何文件，请在电脑上检查回收站")
    for dst in destinations:
        if not restore_destination(dst) or os.path.lexists(dst):
            raise ValueError("原位置已有文件或路径不安全，未覆盖，请检查后重试")
    restored = []
    directories = set()
    for item in records:
        src, dst = item["to"], item["from"]
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        # 原子地创建目标：即使预检后有其它进程新建同名文件，也绝不覆盖它。
        os.link(src, dst)
        os.unlink(src)
        restored.append(dst)
        directories.add(os.path.dirname(src))
    clean_trash_manifests(directories, ctx_id)
    print("\n".join(restored) if restored else "回收站里没有这组（可能已被清理）")


def cmd_list():
    for ctx in merged(LIST_LIMIT):
        sys.stdout.write(f"{ctx['id']}\t{ctx['started']}\t{ctx['count']}\t{ctx['title']}\n")


def main():
    args = sys.argv[1:]
    if args and args[0] == "trash":
        cmd_trash()
        return
    if args and args[0] == "purge" and len(args) == 2:
        cmd_purge(args[1])
        return
    if args and args[0] == "purgebatch":
        if args[1:] == ["--stdin"]:
            data = sys.stdin.read(2 * 1024 * 1024 + 1)
            if len(data) > 2 * 1024 * 1024:
                raise ValueError("批量请求过大")
            ids = json.loads(data)
        else:
            ids = args[1:]
        cmd_purge_batch(ids)
        return
    if args and args[0] == "exportfull" and len(args) > 1:
        # 正文、版本、条数来自同一个快照；直接按 id 查，不受最近 N 组窗口影响。
        cmd_dump_full(0, args[1])
        return
    if args and args[0] == "exportbatch" and len(args) > 1:
        # One index scan and one merged snapshot for the whole batch.
        cmd_dump_full_ids(args[1:])
        return
    if args and args[0] == "dumpfull":
        limit = int(args[1]) if len(args) > 1 and args[1].isdigit() else LIST_LIMIT
        cmd_dump_full(limit)
        return
    if args and args[0] == "dump":
        limit = int(args[1]) if len(args) > 1 and args[1].isdigit() else LIST_LIMIT
        cmd_dump(limit)
        return
    if args and args[0] == "dumpids" and len(args) > 1:
        cmd_dump_ids(args[1:])
        return
    if args and args[0] == "manifest":
        cmd_manifest(args[1] if len(args) > 1 else "")
        return
    if args and args[0] == "restore" and len(args) > 1:
        cmd_restore(args[1])
        return
    if args and args[0] == "rollout":
        cmd_rollout(args[1:] or None)
        return
    if args and args[0] == "delete" and len(args) > 1:
        cmd_delete(args[1], permanent="--permanent" in args[2:])
        return
    if args and args[0] == "list":
        cmd_list()
        return

    contexts = merged(0, args[1]) if args and args[0] == "export" and len(args) > 1 else merged(LIST_LIMIT)
    if args and args[0] == "export" and len(args) > 1:
        wanted = args[1]
        hit = next((c for c in contexts if c["id"] == wanted), None)
        if hit is None:
            raise SystemExit("找不到指定会话")
        sys.stdout.write(hit["body"])
        return

    if not contexts:
        print("（本机没有 codex 会话）")
        return
    sys.stdout.write(contexts[0]["body"])


if __name__ == "__main__":
    main()
